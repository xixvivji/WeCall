{$PUBLIC_HOST} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
  }
  handle /api/* {
    header Cache-Control "no-store"
    reverse_proxy 127.0.0.1:8080
  }
  handle {
    root * /srv
    file_server
  }
}
