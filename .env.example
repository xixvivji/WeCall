# 로컬 계정 최초 생성용. 실제 비밀번호를 채운 뒤 .env로 복사하세요.
# 영문 소문자·숫자·._- 계정명 3~64자. 비밀번호 12자 이상, UTF-8 72바이트 이하.
WECALL_BOOTSTRAP_USERNAME=demo-reviewer
WECALL_BOOTSTRAP_PASSWORD=
WECALL_BOOTSTRAP_OPERATOR_USERNAME=demo-operator
WECALL_BOOTSTRAP_OPERATOR_PASSWORD=
# 시연 스크립트는 검토자로 로그인합니다.
WECALL_USERNAME=demo-reviewer
WECALL_PASSWORD=
